# Copy to .env.local. Every value can stay empty for local development.

# Neon Postgres. Empty locally = built-in PGlite database stored in .data/
DATABASE_URL=

# Vercel Blob (public store). Empty locally = uploads saved to public/uploads/
BLOB_READ_WRITE_TOKEN=

# Portal access: comma-separated emails allowed to sign in
ADMIN_EMAILS=

# Resend. Empty RESEND_API_KEY locally = sign-in links shown on the login page
RESEND_API_KEY=
AUTH_FROM_EMAIL=
CONTACT_FROM_EMAIL=

# Public site URL used in sign-in emails, e.g. https://www.cralebuilders.com
SITE_URL=
